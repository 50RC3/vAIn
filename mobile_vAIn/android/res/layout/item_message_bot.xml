<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/bot_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/bot_avatar_description"
        android:src="@drawable/ic_bot_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/message_card"
        app:tint="@color/bot_avatar_tint" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/message_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="48dp"
        app:cardBackgroundColor="@color/bot_message_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintStart_toEndOf="@id/bot_avatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:padding="12dp"
            android:textColor="@color/bot_message_text"
            android:textSize="16sp"
            android:textIsSelectable="true" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/timestamp_text"
        android:textSize="12sp"
        android:alpha="0.7"
        app:layout_constraintStart_toStartOf="@id/message_card"
        app:layout_constraintTop_toBottomOf="@id/message_card" />

    <com.google.android.material.progressbar.CircularProgressIndicator
        android:id="@+id/typing_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        app:indicatorColor="@color/bot_typing_indicator"
        app:indicatorSize="16dp"
        app:trackThickness="2dp"
        app:layout_constraintBottom_toBottomOf="@id/message_card"
        app:layout_constraintStart_toEndOf="@id/message_card" />

</androidx.constraintlayout.widget.ConstraintLayout>
