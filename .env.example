# NLP Configuration
SPACY_MODEL=en_core_web_sm
NLTK_DATA_PATH=/path/to/nltk_data

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Model Configuration
MODEL_CACHE_DIR=/path/to/model/cache
MAX_SEQUENCE_LENGTH=512

# API Configuration
API_HOST=localhost
API_PORT=8000
API_DEBUG=False

# Task Queue Configuration
TASK_QUEUE_HOST=localhost
TASK_QUEUE_PORT=6379
TASK_QUEUE_DB=0
